#!/bin/bash

#===============================================================================
# Project Status - Dashboard de todos tus proyectos
# Muestra el estado de TODOS tus proyectos de un vistazo
#===============================================================================

set -euo pipefail

# Colores
readonly GREEN='\033[0;32m'
readonly RED='\033[0;31m'
readonly BLUE='\033[0;34m'
readonly CYAN='\033[0;36m'
readonly YELLOW='\033[1;33m'
readonly BOLD='\033[1m'
readonly NC='\033[0m'

PROJECTS_DIR="/home/user/apro/projects"

clear
cat <<'EOF'
╔═══════════════════════════════════════════════════════════════╗
║                                                               ║
║        📊 DASHBOARD DE PROYECTOS                             ║
║        Vista general de todos tus proyectos                  ║
║                                                               ║
╚═══════════════════════════════════════════════════════════════╝
EOF
echo ""

total_projects=0
running_projects=0
modified_today=0

for dir in "$PROJECTS_DIR"/*/; do
    if [ -d "$dir" ]; then
        ((total_projects++))

        project_name=$(basename "$dir")

        # Estado
        status="💤 Stopped"
        status_color=$YELLOW

        if [ -f "$dir/docker-compose.yml" ] || [ -f "$dir/docker-compose.dev.yml" ]; then
            cd "$dir"
            if docker compose ps 2>/dev/null | grep -q "Up"; then
                status="✅ Running"
                status_color=$GREEN
                ((running_projects++))
            fi
        fi

        # Última modificación
        last_modified=$(find "$dir" -type f -name "*.ts" -o -name "*.js" -o -name "*.tsx" -o -name "*.jsx" -o -name "*.py" -o -name "*.php" 2>/dev/null | xargs stat -c %Y 2>/dev/null | sort -rn | head -1)
        if [ -n "$last_modified" ]; then
            today=$(date +%s)
            diff=$((today - last_modified))
            if [ $diff -lt 86400 ]; then
                ((modified_today++))
                last_activity="🔥 Hoy"
            elif [ $diff -lt 604800 ]; then
                last_activity="📅 Esta semana"
            else
                last_activity="⏰ Hace tiempo"
            fi
        else
            last_activity="❓ Sin datos"
        fi

        # Git status
        cd "$dir"
        if [ -d ".git" ]; then
            uncommitted=$(git status --porcelain 2>/dev/null | wc -l)
            if [ "$uncommitted" -gt 0 ]; then
                git_status="⚠️  $uncommitted cambios sin commit"
            else
                git_status="✓ Clean"
            fi
        else
            git_status="- No git"
        fi

        # Imprimir proyecto
        echo -e "${BOLD}${BLUE}▶ $project_name${NC}"
        echo -e "  Estado: ${status_color}$status${NC}"
        echo -e "  Actividad: $last_activity"
        echo -e "  Git: $git_status"
        echo ""
    fi
done

# Resumen
echo -e "${CYAN}${BOLD}═══════════════════════════════════════════════════════════════${NC}"
echo -e "${CYAN}${BOLD}RESUMEN${NC}"
echo -e "${CYAN}${BOLD}═══════════════════════════════════════════════════════════════${NC}"
echo ""
echo -e "  Total de proyectos:      ${BOLD}$total_projects${NC}"
echo -e "  Proyectos corriendo:     ${GREEN}${BOLD}$running_projects${NC}"
echo -e "  Modificados hoy:         ${YELLOW}${BOLD}$modified_today${NC}"
echo ""

# Recursos del sistema
echo -e "${CYAN}${BOLD}RECURSOS DEL SISTEMA${NC}"
echo -e "${CYAN}${BOLD}═══════════════════════════════════════════════════════════════${NC}"
echo ""

# Uso de Docker
if command -v docker &> /dev/null; then
    running_containers=$(docker ps --format '{{.Names}}' | wc -l)
    echo -e "  Contenedores activos:    ${GREEN}$running_containers${NC}"

    # Uso de CPU/RAM de contenedores
    echo ""
    echo -e "  ${BOLD}Top 5 contenedores por uso de recursos:${NC}"
    docker stats --no-stream --format "table {{.Name}}\t{{.CPUPerc}}\t{{.MemUsage}}" 2>/dev/null | head -6
fi

echo ""
echo -e "${CYAN}${BOLD}Comandos útiles:${NC}"
echo -e "  ${BOLD}switch-project${NC}  - Cambiar a otro proyecto"
echo -e "  ${BOLD}apro-manage${NC}     - Gestionar proyecto actual"
echo ""
