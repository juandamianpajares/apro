#===============================================================================
# Función: Detectar proyecto
#===============================================================================

detect_project() {
    if [ -f "$PROJECT_ROOT/docker-compose.yml" ] || [ -f "$PROJECT_ROOT/docker-compose.dev.yml" ]; then
        echo "docker"
    elif [ -f "$PROJECT_ROOT/package.json" ]; then
        echo "nodejs"
    elif [ -f "$PROJECT_ROOT/composer.json" ]; then
        echo "php"
    else
        echo "unknown"
    fi
}

#===============================================================================
# Función: Verificar requisitos
#===============================================================================

check_requirements() {
    header "Verificando Requisitos del Sistema"

    local all_ok=true

    # Docker
    if command -v docker &> /dev/null; then
        log "Docker instalado: $(docker --version | cut -d' ' -f3)"
    else
        error "Docker no está instalado"
        all_ok=false
    fi

    # Docker Compose
    if docker compose version &> /dev/null; then
        log "Docker Compose instalado: $(docker compose version --short)"
    elif command -v docker-compose &> /dev/null; then
        log "Docker Compose (legacy) instalado: $(docker-compose --version | cut -d' ' -f4)"
    else
        error "Docker Compose no está instalado"
        all_ok=false
    fi

    # Git
    if command -v git &> /dev/null; then
        log "Git instalado: $(git --version | cut -d' ' -f3)"
    else
        warn "Git no está instalado (opcional)"
    fi

    # Node.js (si es proyecto Node)
    local project_type=$(detect_project)
    if [ "$project_type" = "docker" ] || [ "$project_type" = "nodejs" ]; then
        if command -v node &> /dev/null; then
            log "Node.js instalado: $(node --version)"
        else
            warn "Node.js no está instalado"
        fi
    fi

    echo ""
    if $all_ok; then
        success "Todos los requisitos están satisfechos"
        return 0
    else
        error "Faltan algunos requisitos. Por favor instálalos primero."
        return 1
    fi
}

#===============================================================================
# Función: Build del proyecto
#===============================================================================

build_project() {
    header "Construyendo Proyecto"

    local env="${1:-dev}"
    local compose_file="docker-compose.yml"

    if [ "$env" = "dev" ] && [ -f "docker-compose.dev.yml" ]; then
        compose_file="docker-compose.dev.yml"
    fi

    info "Usando archivo: $compose_file"
    info "Ambiente: $env"

    if docker compose -f "$compose_file" build --no-cache; then
        success "Build completado exitosamente"
    else
        error "Build falló"
        return 1
    fi
}

#===============================================================================
# Función: Start del proyecto
#===============================================================================

start_project() {
    header "Iniciando Proyecto"

    local env="${1:-dev}"
    local compose_file="docker-compose.yml"

    if [ "$env" = "dev" ] && [ -f "docker-compose.dev.yml" ]; then
        compose_file="docker-compose.dev.yml"
    fi

    info "Usando archivo: $compose_file"
    info "Ambiente: $env"

    # Incluir perfiles según ambiente
    local profiles=""
    if [ "$env" = "dev" ]; then
        profiles="--profile dev"
    fi

    if docker compose -f "$compose_file" $profiles up -d; then
        success "Proyecto iniciado exitosamente"
        echo ""
        info "Servicios corriendo:"
        docker compose -f "$compose_file" ps
    else
        error "Fallo al iniciar proyecto"
        return 1
    fi
}

#===============================================================================
# Función: Stop del proyecto
#===============================================================================

stop_project() {
    header "Deteniendo Proyecto"

    local compose_file="docker-compose.yml"
    [ -f "docker-compose.dev.yml" ] && compose_file="docker-compose.dev.yml"

    if docker compose -f "$compose_file" down; then
        success "Proyecto detenido exitosamente"
    else
        error "Fallo al detener proyecto"
        return 1
    fi
}

#===============================================================================
# Función: Restart del proyecto
#===============================================================================

restart_project() {
    header "Reiniciando Proyecto"

    stop_project
    sleep 2
    start_project "${1:-dev}"
}

#===============================================================================
# Función: Logs del proyecto
#===============================================================================

show_logs() {
    header "Mostrando Logs"

    local service="${1:-}"
    local compose_file="docker-compose.yml"
    [ -f "docker-compose.dev.yml" ] && compose_file="docker-compose.dev.yml"

    if [ -n "$service" ]; then
        info "Logs del servicio: $service"
        docker compose -f "$compose_file" logs -f --tail=100 "$service"
    else
        info "Logs de todos los servicios"
        docker compose -f "$compose_file" logs -f --tail=100
    fi
}

#===============================================================================
# Función: Status del proyecto
#===============================================================================

show_status() {
    header "Estado del Proyecto"

    local compose_file="docker-compose.yml"
    [ -f "docker-compose.dev.yml" ] && compose_file="docker-compose.dev.yml"

    info "Contenedores:"
    docker compose -f "$compose_file" ps

    echo ""
    info "Uso de recursos:"
    docker stats --no-stream --format "table {{.Container}}\t{{.CPUPerc}}\t{{.MemUsage}}\t{{.NetIO}}"

    echo ""
    info "Volúmenes:"
    docker volume ls --filter "name=$(basename "$PROJECT_ROOT")"
}

#===============================================================================
# Función: Clean (eliminar contenedores, volúmenes, etc.)
#===============================================================================

clean_project() {
    header "Limpiando Proyecto"

    warn "Esta acción eliminará todos los contenedores, volúmenes e imágenes del proyecto"
    read -p "¿Estás seguro? (yes/no): " -r

    if [[ ! $REPLY =~ ^[Yy][Ee][Ss]$ ]]; then
        info "Cancelado por el usuario"
        return 0
    fi

    local compose_file="docker-compose.yml"
    [ -f "docker-compose.dev.yml" ] && compose_file="docker-compose.dev.yml"

    info "Deteniendo y eliminando contenedores..."
    docker compose -f "$compose_file" down -v --remove-orphans

    info "Eliminando imágenes del proyecto..."
    docker images --filter "reference=*$(basename "$PROJECT_ROOT")*" -q | xargs -r docker rmi -f

    info "Eliminando volúmenes huérfanos..."
    docker volume prune -f

    success "Limpieza completada"
}

#===============================================================================
# Función: Test - ejecutar tests
#===============================================================================

run_tests() {
    header "Ejecutando Tests"

    local compose_file="docker-compose.yml"
    [ -f "docker-compose.dev.yml" ] && compose_file="docker-compose.dev.yml"

    info "Ejecutando tests dentro del contenedor..."
    docker compose -f "$compose_file" exec app npm test
}

#===============================================================================
# Función: Shell - acceder a shell del contenedor
#===============================================================================

shell_access() {
    header "Acceso a Shell"

    local service="${1:-app}"
    local compose_file="docker-compose.yml"
    [ -f "docker-compose.dev.yml" ] && compose_file="docker-compose.dev.yml"

    info "Accediendo a shell del servicio: $service"
    docker compose -f "$compose_file" exec "$service" /bin/sh || \
    docker compose -f "$compose_file" exec "$service" /bin/bash
}

#===============================================================================
# Función: Database - operaciones de base de datos
#===============================================================================

db_operations() {
    header "Operaciones de Base de Datos"

    local compose_file="docker-compose.yml"
    [ -f "docker-compose.dev.yml" ] && compose_file="docker-compose.dev.yml"

    echo "Selecciona una operación:"
    echo "  1) Backup de base de datos"
    echo "  2) Restore de base de datos"
    echo "  3) Acceder a MySQL CLI"
    echo "  4) Ver logs de MySQL"
    echo "  5) Volver"
    echo ""
    read -p "Opción: " -r db_option

    case $db_option in
        1)
            info "Creando backup..."
            local backup_file="backup_$(date +%Y%m%d_%H%M%S).sql"
            docker compose -f "$compose_file" exec db mysqldump -u root -p"${MYSQL_ROOT_PASSWORD:-DevPass123}" "${MYSQL_DATABASE:-dalintex_stock_dev}" > "$backup_file"
            success "Backup creado: $backup_file"
            ;;
        2)
            read -p "Archivo de backup: " -r backup_file
            if [ -f "$backup_file" ]; then
                info "Restaurando backup..."
                docker compose -f "$compose_file" exec -T db mysql -u root -p"${MYSQL_ROOT_PASSWORD:-DevPass123}" "${MYSQL_DATABASE:-dalintex_stock_dev}" < "$backup_file"
                success "Backup restaurado"
            else
                error "Archivo no encontrado: $backup_file"
            fi
            ;;
        3)
            info "Accediendo a MySQL CLI..."
            docker compose -f "$compose_file" exec db mysql -u root -p"${MYSQL_ROOT_PASSWORD:-DevPass123}" "${MYSQL_DATABASE:-dalintex_stock_dev}"
            ;;
        4)
            docker compose -f "$compose_file" logs -f db
            ;;
        5)
            return 0
            ;;
        *)
            error "Opción inválida"
            ;;
    esac
}

#===============================================================================
# Función: Setup inicial del proyecto
#===============================================================================

setup_project() {
    header "Setup Inicial del Proyecto"

    info "Creando archivo .env desde .env.example..."
    if [ -f ".env.example" ] && [ ! -f ".env" ]; then
        cp .env.example .env
        success ".env creado"
        warn "Por favor edita .env con tus configuraciones"
    else
        info ".env ya existe"
    fi

    info "Construyendo imágenes..."
    build_project "${1:-dev}"

    info "Iniciando servicios..."
    start_project "${1:-dev}"

    success "Setup completado"
}

#===============================================================================
# Menú principal
#===============================================================================

show_menu() {
    show_banner

    local project_type=$(detect_project)
    info "Tipo de proyecto detectado: $project_type"
    info "Directorio: $PROJECT_ROOT"
    echo ""

    echo "${BOLD}Opciones Disponibles:${NC}"
    echo ""
    echo "  ${CYAN}Gestión de Servicios:${NC}"
    echo "    1)  Setup inicial (first run)"
    echo "    2)  Build del proyecto"
    echo "    3)  Start (iniciar servicios)"
    echo "    4)  Stop (detener servicios)"
    echo "    5)  Restart (reiniciar servicios)"
    echo "    6)  Status (ver estado)"
    echo ""
    echo "  ${CYAN}Desarrollo:${NC}"
    echo "    7)  Logs (ver logs)"
    echo "    8)  Shell (acceder a contenedor)"
    echo "    9)  Tests (ejecutar tests)"
    echo ""
    echo "  ${CYAN}Base de Datos:${NC}"
    echo "    10) Operaciones de BD"
    echo ""
    echo "  ${CYAN}Mantenimiento:${NC}"
    echo "    11) Clean (limpiar todo)"
    echo "    12) Verificar requisitos"
    echo ""
    echo "    0)  Salir"
    echo ""
    read -p "Selecciona una opción: " -r option

    case $option in
        1) setup_project ;;
        2) build_project ;;
        3) start_project ;;
        4) stop_project ;;
        5) restart_project ;;
        6) show_status ;;
        7) show_logs ;;
        8) shell_access ;;
        9) run_tests ;;
        10) db_operations ;;
        11) clean_project ;;
        12) check_requirements ;;
        0) exit 0 ;;
        *) error "Opción inválida" ;;
    esac

    echo ""
    read -p "Presiona Enter para continuar..." -r
    show_menu
}

#===============================================================================
# Main
#===============================================================================

main() {
    # Si se pasa comando por argumentos
    if [ $# -gt 0 ]; then
        case "$1" in
            setup) setup_project "${2:-dev}" ;;
            build) build_project "${2:-dev}" ;;
            start) start_project "${2:-dev}" ;;
            stop) stop_project ;;
            restart) restart_project "${2:-dev}" ;;
            status) show_status ;;
            logs) show_logs "${2:-}" ;;
            shell) shell_access "${2:-app}" ;;
            test) run_tests ;;
            db) db_operations ;;
            clean) clean_project ;;
            check) check_requirements ;;
            help)
                show_banner
                echo "Uso: $0 [comando] [opciones]"
                echo ""
                echo "Comandos:"
                echo "  setup [env]    - Setup inicial (env: dev|prod)"
                echo "  build [env]    - Build del proyecto"
                echo "  start [env]    - Iniciar servicios"
                echo "  stop           - Detener servicios"
                echo "  restart [env]  - Reiniciar servicios"
                echo "  status         - Ver estado"
                echo "  logs [service] - Ver logs"
                echo "  shell [service]- Acceder a shell"
                echo "  test           - Ejecutar tests"
                echo "  db             - Operaciones de BD"
                echo "  clean          - Limpiar todo"
                echo "  check          - Verificar requisitos"
                echo "  help           - Esta ayuda"
                echo ""
                echo "Sin argumentos se muestra el menú interactivo"
                ;;
            *)
                error "Comando desconocido: $1"
                echo "Usa '$0 help' para ver comandos disponibles"
                exit 1
                ;;
        esac
    else
        # Menú interactivo
        show_menu
    fi
}

# Ejecutar
main "$@"
